# Same schema backend/ writes to — SQLite path for local dev (matches
# backend's .env DATABASE_URL), a mysql:// URL in production.
DATABASE_URL=sqlite:///../backend/var/data_dev.db

# Themes with fewer than this many attempts are too noisy to bias selection on.
MIN_SAMPLE_SIZE=5

PORT=8001

# "My Games" (chess.com blunder import) — path to the Stockfish binary.
# Defaults to relying on $PATH, which is what the production container
# (apt-installs the `stockfish` package) does. Override locally if it's not
# on PATH, e.g. after a manual/winget install on Windows:
# STOCKFISH_PATH=C:/path/to/stockfish.exe
